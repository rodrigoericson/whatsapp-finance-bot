{
  "name": "whatsapp-finance-bot",
  "version": "0.1.0",
  "description": "Bot simples de WhatsApp para registrar gastos em grupo e gerar resumos financeiros.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "oxlint .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "migrate": "tsx src/db/migrate.ts",
    "reset-auth": "tsx scripts/reset-auth.ts"
  },
  "keywords": [
    "whatsapp",
    "finance",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode-terminal": "^0.12.2",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
